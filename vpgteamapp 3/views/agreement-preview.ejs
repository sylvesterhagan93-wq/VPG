<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>VPGteamapp - Preview <%= typeDef.label %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/topbar') %>

  <div class="container preview-container">
    <div class="page-title">Preview: <%= typeDef.label %></div>
    <div class="page-subtitle">
      This is exactly the document that will be sent to
      <strong><%= partySummary %></strong> for e-signature<% if (fullPropertyAddress) { %>
      for <strong><%= fullPropertyAddress %></strong><% } %>. Nothing has been sent yet -
      review it below, then Approve &amp; Send or go back and make changes.
    </div>

    <div class="alert info">
      Nothing has gone out yet. This document only sends once you click <strong>Approve &amp; Send</strong> below.
    </div>

    <div class="card pdf-preview-card">
      <embed
        src="data:application/pdf;base64,<%= pdfBase64 %>"
        type="application/pdf"
        class="pdf-preview-frame"
      />
      <p class="pdf-preview-fallback">
        Can't see the document above? Your browser may not support inline PDF preview -
        <a href="data:application/pdf;base64,<%= pdfBase64 %>" target="_blank" rel="noopener">open it in a new tab</a> instead.
      </p>
    </div>

    <div class="preview-actions">
      <form method="POST" action="/agreements/new/<%= typeDef.key %>/edit">
        <input type="hidden" name="formDataJson" value="<%= formDataJson %>" />
        <button type="submit" class="btn btn-secondary">&larr; Back to Edit</button>
      </form>
      <form method="POST" action="/agreements/new/<%= typeDef.key %>/send">
        <input type="hidden" name="formDataJson" value="<%= formDataJson %>" />
        <button type="submit" class="btn">Approve &amp; Send</button>
      </form>
    </div>
  </div>
</body>
</html>
