<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>VPGteamapp - Dashboard</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/topbar') %>

  <div class="container">
    <div class="cleveland-widget">
      <div class="cleveland-widget-loc">Cleveland, OH</div>
      <div class="cleveland-widget-time" id="cleveland-time">&mdash;</div>
      <div class="cleveland-widget-sep">&middot;</div>
      <div class="cleveland-widget-weather" id="cleveland-weather">
        <% if (clevelandWeather && clevelandWeather.tempF !== undefined) { %>
          <%= clevelandWeather.tempF %>&deg;F<% if (clevelandWeather.description) { %>, <%= clevelandWeather.description %><% } %>
        <% } else { %>
          Weather unavailable
        <% } %>
      </div>
    </div>

    <div class="page-title">Send an Agreement</div>
    <div class="page-subtitle">Pick a document type, fill in the details, and it will be sent out for signature.</div>

    <% if (!process.env.HELLOSIGN_API_KEY) { %>
      <div class="mock-note">
        HelloSign API key is not configured yet - agreements will be generated but sent in MOCK mode (no real signature request goes out). Add HELLOSIGN_API_KEY to your .env to go live.
      </div>
    <% } %>

    <div class="type-grid">
      <% types.forEach(function(t) { %>
        <a class="type-card" href="/agreements/new/<%= t.key %>">
          <h3><%= t.label %></h3>
          <p><%= t.description %></p>
          <span class="btn-label">Fill out &amp; send &rarr;</span>
        </a>
      <% }) %>
    </div>

    <div class="page-title" style="font-size:18px;">Recent Activity</div>

    <% if (isAdmin && deletedAgreement) { %>
      <div class="alert info" style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
        <span>
          Deleted the <%= deletedAgreement.type.charAt(0).toUpperCase() + deletedAgreement.type.slice(1) %> agreement<% if (deletedAgreement.property_address) { %> for <strong><%= deletedAgreement.property_address %></strong><% } else if (deletedAgreement.party_summary) { %> for <strong><%= deletedAgreement.party_summary %></strong><% } %> from Recent Activity.
        </span>
        <form method="POST" action="/agreements/<%= deletedAgreement.id %>/restore" style="margin:0;">
          <button type="submit" class="btn-tiny reactivate">Undo</button>
        </form>
      </div>
    <% } %>

    <div class="card">
      <% if (recent.length === 0) { %>
        <div class="empty-state">No agreements sent yet. Pick a document type above to get started.</div>
      <% } else { %>
        <table class="history">
          <thead>
            <tr>
              <th>Type</th>
              <th>Parties</th>
              <th>Property</th>
              <th>Sent By</th>
              <th>Status</th>
              <th>Date</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% recent.forEach(function(a) { %>
              <tr>
                <td><%= a.type.charAt(0).toUpperCase() + a.type.slice(1) %></td>
                <td><%= a.party_summary || '-' %></td>
                <td><%= a.property_address || '-' %></td>
                <td><%= a.sent_by_name %></td>
                <td><span class="badge <%= a.status %>"><%= a.status.replace('_', ' ') %></span></td>
                <td><%= new Date(a.created_at).toLocaleString('en-US') %></td>
                <td style="white-space:nowrap;">
                  <% if (a.status === 'signed') { %>
                    <a class="btn-tiny download-link" href="/agreements/<%= a.id %>/download">Download</a>
                  <% } %>
                  <% if (isAdmin) { %>
                    <form method="POST" action="/agreements/<%= a.id %>/delete" style="display:inline;"
                          onsubmit="return confirm('Remove this agreement from Recent Activity? You can undo it right after.');">
                      <button type="submit" class="btn-tiny">Delete</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <script>
    // Always Cleveland's local time, no matter where whoever's looking at
    // the dashboard actually is - ticks every second off the system clock,
    // just formatted for the America/New_York timezone.
    var clevelandTimeFormatter = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/New_York',
      hour: 'numeric',
      minute: '2-digit',
      second: '2-digit',
      hour12: true,
    });

    function tickClevelandTime() {
      var el = document.getElementById('cleveland-time');
      if (el) el.textContent = clevelandTimeFormatter.format(new Date());
    }
    tickClevelandTime();
    setInterval(tickClevelandTime, 1000);

    // Weather doesn't need per-second updates - refresh it quietly every 15
    // minutes for anyone who leaves the dashboard open. Best-effort: if the
    // request fails, just leave whatever was already showing.
    function refreshClevelandWeather() {
      fetch('/weather/cleveland')
        .then(function (res) { return res.json(); })
        .then(function (data) {
          var el = document.getElementById('cleveland-weather');
          if (!el || !data || data.tempF === undefined) return;
          el.textContent = data.tempF + '°F' + (data.description ? ', ' + data.description : '');
        })
        .catch(function () { /* leave the last known value showing */ });
    }
    setInterval(refreshClevelandWeather, 15 * 60 * 1000);
  </script>
</body>
</html>
