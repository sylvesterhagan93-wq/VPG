<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>VPGteamapp - Dashboard</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/topbar') %>

  <div class="container">
    <div class="cleveland-widget">
      <div class="cleveland-widget-loc">Cleveland, OH</div>
      <div class="cleveland-widget-time" id="cleveland-time">&mdash;</div>
      <div class="cleveland-widget-sep">&middot;</div>
      <div class="cleveland-widget-weather" id="cleveland-weather">
        <% if (clevelandWeather && clevelandWeather.tempF !== undefined) { %>
          <%= clevelandWeather.tempF %>&deg;F<% if (clevelandWeather.description) { %>, <%= clevelandWeather.description %><% } %>
        <% } else { %>
          Weather unavailable
        <% } %>
      </div>
    </div>

    <% if (buyerAlerts && buyerAlerts.length > 0) { %>
      <div class="buyer-alerts-panel">
        <div class="buyer-alerts-panel-title">
          <span class="buyer-alerts-dot"></span>
          Buyer Alerts - <%= buyerAlerts.length %> deal<%= buyerAlerts.length === 1 ? '' : 's' %> to follow up on
        </div>
        <% buyerAlerts.forEach(function(a) { %>
          <div class="buyer-alert-row">
            <div class="buyer-alert-info">
              <strong><%= a.buyer_name %></strong> buys in <strong><%= a.state %></strong> - new deal at
              <strong><%= a.deal_address %><%= a.deal_city ? ', ' + a.deal_city : '' %></strong>.
              <span class="buyer-alert-contact">
                <% if (a.buyer_phone) { %><%= a.buyer_phone %><% } %><% if (a.buyer_phone && a.buyer_email) { %> &middot; <% } %><% if (a.buyer_email) { %><%= a.buyer_email %><% } %>
              </span>
            </div>
            <form method="POST" action="/buyer-alerts/<%= a.id %>/dismiss" style="margin:0;">
              <button type="submit" class="btn-tiny reactivate">Mark contacted</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } %>

    <div class="page-title">Send an Agreement</div>
    <div class="page-subtitle">Pick a document type, fill in the details, and it will be sent out for signature.</div>

    <% if (!process.env.HELLOSIGN_API_KEY) { %>
      <div class="mock-note">
        HelloSign API key is not configured yet - agreements will be generated but sent in MOCK mode (no real signature request goes out). Add HELLOSIGN_API_KEY to your .env to go live.
      </div>
    <% } %>

    <div class="type-grid">
      <% types.forEach(function(t) { %>
        <a class="type-card" href="/agreements/new/<%= t.key %>">
          <h3><%= t.label %></h3>
          <p><%= t.description %></p>
          <span class="btn-label">Fill out &amp; send &rarr;</span>
        </a>
      <% }) %>
      <a class="type-card" href="/offer-letters/new">
        <h3>Offer Letter</h3>
        <p>Emailed purchase proposal for a seller - not a signature request, just the branded PDF attached to an email.</p>
        <span class="btn-label">Fill out &amp; email &rarr;</span>
      </a>
    </div>

    <div class="page-title" style="font-size:18px;">Recent Activity</div>

    <% if (isAdmin && deletedAgreement) { %>
      <div class="alert info" style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
        <span>
          Deleted the <%= deletedAgreement.type.charAt(0).toUpperCase() + deletedAgreement.type.slice(1) %> agreement<% if (deletedAgreement.property_address) { %> for <strong><%= deletedAgreement.property_address %></strong><% } else if (deletedAgreement.party_summary) { %> for <strong><%= deletedAgreement.party_summary %></strong><% } %> from Recent Activity.
        </span>
        <form method="POST" action="/agreements/<%= deletedAgreement.id %>/restore" style="margin:0;">
          <button type="submit" class="btn-tiny reactivate">Undo</button>
        </form>
      </div>
    <% } %>

    <% if (resendNotice) { %>
      <% if (resendNotice.kind === 'success') { %>
        <div class="alert info">
          Sent a reminder for the <%= resendNotice.agreement.type.charAt(0).toUpperCase() + resendNotice.agreement.type.slice(1) %> agreement<% if (resendNotice.agreement.property_address) { %> for <strong><%= resendNotice.agreement.property_address %></strong><% } else if (resendNotice.agreement.party_summary) { %> for <strong><%= resendNotice.agreement.party_summary %></strong><% } %> to <%= resendNotice.remindedCount %> pending signer<%= resendNotice.remindedCount === 1 ? '' : 's' %>.
        </div>
      <% } else { %>
        <div class="alert error"><%= resendNotice.message %></div>
      <% } %>
    <% } %>

    <div class="card">
      <% if (recent.length === 0) { %>
        <div class="empty-state">No agreements sent yet. Pick a document type above to get started.</div>
      <% } else { %>
        <table class="history">
          <thead>
            <tr>
              <th>Type</th>
              <th>Parties</th>
              <th>Property</th>
              <th>Sent By</th>
              <th>Status</th>
              <th>Date</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% recent.forEach(function(a) { %>
              <tr>
                <td><%= a.type.charAt(0).toUpperCase() + a.type.slice(1) %></td>
                <td><%= a.party_summary || '-' %></td>
                <td><%= a.property_address || '-' %></td>
                <td><%= a.sent_by_name %></td>
                <td><span class="badge <%= a.status %>"><%= a.status.replace('_', ' ') %></span></td>
                <td><%= new Date(a.created_at).toLocaleString('en-US') %></td>
                <td style="white-space:nowrap;">
                  <% if (a.status === 'signed') { %>
                    <a class="btn-tiny download-link" href="/agreements/<%= a.id %>/download">Download</a>
                  <% } %>
                  <% if (a.status === 'sent' && a.hellosign_request_id && a.hellosign_request_id.indexOf('mock-') !== 0) { %>
                    <form method="POST" action="/agreements/<%= a.id %>/resend" style="display:inline;"
                          onsubmit="return confirm('Resend the signature request reminder to whoever hasn\'t signed yet?');">
                      <button type="submit" class="btn-tiny">Resend</button>
                    </form>
                  <% } %>
                  <% if (isAdmin) { %>
                    <form method="POST" action="/agreements/<%= a.id %>/delete" style="display:inline;"
                          onsubmit="return confirm('Remove this agreement from Recent Activity? You can undo it right after.');">
                      <button type="submit" class="btn-tiny">Delete</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="page-title" style="font-size:18px;">Offer Letters</div>

    <% if (isAdmin && deletedOfferLetter) { %>
      <div class="alert info" style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
        <span>
          Deleted the Offer Letter for <strong><%= deletedOfferLetter.seller_name %></strong><% if (deletedOfferLetter.property_address) { %> (<%= deletedOfferLetter.property_address %>)<% } %> from history.
        </span>
        <form method="POST" action="/offer-letters/<%= deletedOfferLetter.id %>/restore" style="margin:0;">
          <button type="submit" class="btn-tiny reactivate">Undo</button>
        </form>
      </div>
    <% } %>

    <% if (offerResendNotice) { %>
      <% if (offerResendNotice.kind === 'success') { %>
        <div class="alert info">
          Resent the Offer Letter to <strong><%= offerResendNotice.letter.seller_name %></strong><% if (offerResendNotice.letter.property_address) { %> (<%= offerResendNotice.letter.property_address %>)<% } %>.
        </div>
      <% } else { %>
        <div class="alert error"><%= offerResendNotice.message %></div>
      <% } %>
    <% } %>

    <div class="card">
      <% if (!offerLetters || offerLetters.length === 0) { %>
        <div class="empty-state">No offer letters sent yet. Use the Offer Letter card above to send one.</div>
      <% } else { %>
        <table class="history">
          <thead>
            <tr>
              <th>Seller</th>
              <th>Property</th>
              <th>Sent By</th>
              <th>Status</th>
              <th>Date</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% offerLetters.forEach(function(o) { %>
              <tr>
                <td><%= o.seller_name %></td>
                <td><%= o.property_address %></td>
                <td><%= o.sent_by_name %></td>
                <td><span class="badge <%= o.status %>"><%= o.status.replace('_', ' ') %></span></td>
                <td><%= new Date(o.created_at).toLocaleString('en-US') %></td>
                <td style="white-space:nowrap;">
                  <a class="btn-tiny download-link" href="/offer-letters/<%= o.id %>/download">Download</a>
                  <form method="POST" action="/offer-letters/<%= o.id %>/resend" style="display:inline;"
                        onsubmit="return confirm('Resend this offer letter email, with the same PDF attached, to this seller?');">
                    <button type="submit" class="btn-tiny">Resend</button>
                  </form>
                  <% if (isAdmin) { %>
                    <form method="POST" action="/offer-letters/<%= o.id %>/delete" style="display:inline;"
                          onsubmit="return confirm('Remove this offer letter from history? You can undo it right after.');">
                      <button type="submit" class="btn-tiny">Delete</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <script>
    // Always Cleveland's local time, no matter where whoever's looking at
    // the dashboard actually is - ticks every second off the system clock,
    // just formatted for the America/New_York timezone.
    var clevelandTimeFormatter = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/New_York',
      hour: 'numeric',
      minute: '2-digit',
      second: '2-digit',
      hour12: true,
    });

    function tickClevelandTime() {
      var el = document.getElementById('cleveland-time');
      if (el) el.textContent = clevelandTimeFormatter.format(new Date());
    }
    tickClevelandTime();
    setInterval(tickClevelandTime, 1000);

    // Weather doesn't need per-second updates - refresh it quietly every 15
    // minutes for anyone who leaves the dashboard open. Best-effort: if the
    // request fails, just leave whatever was already showing.
    function refreshClevelandWeather() {
      fetch('/weather/cleveland')
        .then(function (res) { return res.json(); })
        .then(function (data) {
          var el = document.getElementById('cleveland-weather');
          if (!el || !data || data.tempF === undefined) return;
          el.textContent = data.tempF + '°F' + (data.description ? ', ' + data.description : '');
        })
        .catch(function () { /* leave the last known value showing */ });
    }
    setInterval(refreshClevelandWeather, 15 * 60 * 1000);
  </script>
</body>
</html>
