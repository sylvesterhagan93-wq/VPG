<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>VPGteamapp - Dashboard</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/topbar') %>

  <div class="container">
    <div class="cleveland-widget">
      <div class="cleveland-widget-loc">Cleveland, OH</div>
      <div class="cleveland-widget-time" id="cleveland-time">&mdash;</div>
      <div class="cleveland-widget-sep">&middot;</div>
      <div class="cleveland-widget-weather" id="cleveland-weather">
        <% if (clevelandWeather && clevelandWeather.tempF !== undefined) { %>
          <%= clevelandWeather.tempF %>&deg;F<% if (clevelandWeather.description) { %>, <%= clevelandWeather.description %><% } %>
        <% } else { %>
          Weather unavailable
        <% } %>
      </div>
    </div>

    <div class="dash-grid">
      <div class="card dash-panel">
        <div class="section-label" style="margin-top:0;">Announcements</div>
        <% if (announcements.length === 0) { %>
          <div class="empty-state">No announcements yet.</div>
        <% } else { %>
          <% announcements.forEach(function(a) { %>
            <div class="announcement-item">
              <p><%= a.body %></p>
              <div class="announcement-meta">
                <%= a.author_name %> &middot; <%= new Date(a.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                <% if (isAdmin) { %>
                  <form method="POST" action="/announcements/<%= a.id %>/delete" style="display:inline;"
                        onsubmit="return confirm('Delete this announcement?');">
                    <button type="submit" class="linklike-delete">Delete</button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } %>
        <% if (isAdmin) { %>
          <form method="POST" action="/announcements" class="announcement-form">
            <textarea name="body" placeholder="Post an announcement to the team..." required></textarea>
            <button type="submit" class="btn-tiny">Post</button>
          </form>
        <% } %>
      </div>

      <div class="card dash-panel">
        <div class="section-label" style="margin-top:0;">Acquisition vs Disposition</div>
        <div class="leaderboard-block">
          <div class="leaderboard-title">Sent This Week</div>
          <ol class="leaderboard-list">
            <% sentLeaderboard.forEach(function(row) { %>
              <li><span><%= row.name %></span><span class="leaderboard-count"><%= row.count %></span></li>
            <% }) %>
          </ol>
        </div>
        <div class="leaderboard-block">
          <div class="leaderboard-title">Signed This Month</div>
          <ol class="leaderboard-list">
            <% signedLeaderboard.forEach(function(row) { %>
              <li><span><%= row.name %></span><span class="leaderboard-count"><%= row.count %></span></li>
            <% }) %>
          </ol>
        </div>
      </div>

      <div class="card dash-panel">
        <div class="section-label" style="margin-top:0;">Upcoming Closings</div>
        <% if (upcomingClosings.length === 0) { %>
          <div class="empty-state">Nothing with an expected closing date coming up.</div>
        <% } else { %>
          <ul class="closings-list">
            <% upcomingClosings.forEach(function(d) { %>
              <%
                const daysUntil = Math.ceil((new Date(d.expected_closing_date) - new Date(new Date().toDateString())) / (1000 * 60 * 60 * 24));
              %>
              <li>
                <span class="closings-address"><%= d.address %></span>
                <span class="closings-date">
                  <%= new Date(d.expected_closing_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                  <span class="you-tag"><%= daysUntil === 0 ? 'today' : (daysUntil === 1 ? 'tomorrow' : daysUntil + ' days') %></span>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    // Always Cleveland's local time, no matter where whoever's looking at
    // the dashboard actually is - ticks every second off the system clock,
    // just formatted for the America/New_York timezone.
    var clevelandTimeFormatter = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/New_York',
      hour: 'numeric',
      minute: '2-digit',
      second: '2-digit',
      hour12: true,
    });

    function tickClevelandTime() {
      var el = document.getElementById('cleveland-time');
      if (el) el.textContent = clevelandTimeFormatter.format(new Date());
    }
    tickClevelandTime();
    setInterval(tickClevelandTime, 1000);

    // Weather doesn't need per-second updates - refresh it quietly every 15
    // minutes for anyone who leaves the dashboard open. Best-effort: if the
    // request fails, just leave whatever was already showing.
    function refreshClevelandWeather() {
      fetch('/weather/cleveland')
        .then(function (res) { return res.json(); })
        .then(function (data) {
          var el = document.getElementById('cleveland-weather');
          if (!el || !data || data.tempF === undefined) return;
          el.textContent = data.tempF + '°F' + (data.description ? ', ' + data.description : '');
        })
        .catch(function () { /* leave the last known value showing */ });
    }
    setInterval(refreshClevelandWeather, 15 * 60 * 1000);
  </script>
</body>
</html>
