<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>VPGteamapp - Sent</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/topbar') %>

  <div class="container">
    <div class="page-title"><%= typeDef.label %> Sent</div>

    <% if (result.mode === 'mock') { %>
      <div class="alert info">
        <strong>Mock mode:</strong> No HelloSign API key is configured, so this was not actually sent for signature.
        The agreement document was generated successfully and this send was logged as
        <span class="badge mock_sent">mock sent</span>. Add your HELLOSIGN_API_KEY to send for real.
      </div>
    <% } else { %>
      <div class="alert info">
        Sent to <strong><%= partySummary %></strong> for signature via HelloSign.
        Request ID: <code><%= result.requestId %></code>
      </div>
    <% } %>

    <div class="card">
      <p>You can track its status on the <a href="/dashboard">dashboard</a>.</p>
      <a href="/dashboard" class="btn">Back to Dashboard</a>
    </div>
  </div>
</body>
</html>
