<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>VPGteamapp - <%= typeDef.label %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/topbar') %>

  <div class="container">
    <div class="page-title"><%= typeDef.label %></div>
    <div class="page-subtitle"><%= typeDef.description %></div>

    <% if (error) { %>
      <div class="alert error"><%= error %></div>
    <% } %>

    <div class="card">
      <form method="POST" action="/agreements/new/<%= typeDef.key %>">

        <div class="section-label">Signers</div>
        <% typeDef.signers.forEach(function(s) { %>
          <div class="signer-row">
            <div class="signer-label">
              <%= s.label %>
              <% if (s.internal) { %>
                <span class="locked-tag">&#128274; locked to the account owner</span>
              <% } %>
            </div>
            <% if (s.internal) { %>
              <div class="field" style="margin-bottom:0;">
                <label>Name</label>
                <input type="text" value="<%= vpgPrincipal.name %>" disabled />
              </div>
              <div class="field" style="margin-bottom:0;">
                <label>Email</label>
                <input type="email" value="<%= vpgPrincipal.email %>" disabled />
              </div>
            <% } else if (s.multiple) { %>
              <div class="multi-signer-group" data-role="<%= s.key %>">
                <% (multiSignerEntries[s.key] || [{ name: '', email: '' }]).forEach(function(entry, idx) { %>
                  <div class="multi-signer-entry">
                    <div class="field" style="margin-bottom:0;">
                      <label>Name</label>
                      <input type="text" name="signer_<%= s.key %>_name[]" value="<%= entry.name || '' %>" <%= idx === 0 ? 'required' : '' %> />
                    </div>
                    <div class="field" style="margin-bottom:0;">
                      <label>Email</label>
                      <input type="email" name="signer_<%= s.key %>_email[]" value="<%= entry.email || '' %>" <%= idx === 0 ? 'required' : '' %> />
                    </div>
                    <button type="button" class="btn-tiny remove-signer-row"
                            onclick="removeSignerRow(this)"
                            <%= (multiSignerEntries[s.key] || []).length <= 1 ? 'style="visibility:hidden;"' : '' %>>Remove</button>
                  </div>
                <% }) %>
                <button type="button" class="btn-secondary btn-add-signer" onclick="addSignerRow(this, '<%= s.key %>')">
                  + Add Another <%= s.addButtonLabel || s.label %>
                </button>
              </div>
            <% } else { %>
              <div class="field" style="margin-bottom:0;">
                <label for="signer_<%= s.key %>_name">Name</label>
                <input type="text" id="signer_<%= s.key %>_name" name="signer_<%= s.key %>_name"
                       value="<%= formValues['signer_' + s.key + '_name'] || '' %>" required />
              </div>
              <div class="field" style="margin-bottom:0;">
                <label for="signer_<%= s.key %>_email">Email</label>
                <input type="email" id="signer_<%= s.key %>_email" name="signer_<%= s.key %>_email"
                       value="<%= formValues['signer_' + s.key + '_email'] || '' %>" required />
              </div>
            <% } %>
          </div>
        <% }) %>

        <%
          // Group fields by their optional `section`, preserving field order.
          // Fields with no section fall under the default "Agreement Details" group.
          const groups = [];
          typeDef.fields.forEach(function(f) {
            const label = f.section || "Agreement Details";
            let group = groups.find(function(g) { return g.label === label; });
            if (!group) { group = { label: label, fields: [] }; groups.push(group); }
            group.fields.push(f);
          });
        %>
        <% groups.forEach(function(group) { %>
          <div class="section-label"><%= group.label %></div>
          <% if (group.label === "Escrow / Title Company") { %>
            <div class="field full" style="margin-bottom:14px;">
              <label for="saved_title_company">Saved Company <span class="you-tag">(optional - fills in the fields below, still fully editable)</span></label>
              <select id="saved_title_company" onchange="applySavedTitleCompany(this)">
                <option value="">Choose a saved company, or just type below for a new one&hellip;</option>
                <% titleCompanies.forEach(function(c, idx) { %>
                  <option value="<%= idx %>"><%= c.name %></option>
                <% }) %>
              </select>
            </div>
          <% } %>
          <div class="form-grid">
            <% group.fields.forEach(function(f) { %>
              <div class="field <%= f.type === 'textarea' ? 'full' : '' %>">
                <label for="<%= f.key %>"><%= f.label %><% if (f.required) { %> *<% } %></label>
                <% if (f.type === 'textarea') { %>
                  <textarea id="<%= f.key %>" name="<%= f.key %>" <%= f.required ? 'required' : '' %>><%= formValues[f.key] || '' %></textarea>
                <% } else if (f.type === 'date') { %>
                  <input type="date" id="<%= f.key %>" name="<%= f.key %>" value="<%= formValues[f.key] || '' %>" <%= f.required ? 'required' : '' %> />
                <% } else if (f.type === 'state_select') { %>
                  <% const selectedState = formValues[f.key] || f.default || ''; %>
                  <select id="<%= f.key %>" name="<%= f.key %>" class="state-select" <%= f.required ? 'required' : '' %>
                          onchange="onStateChange(this)">
                    <option value="">Select a state&hellip;</option>
                    <% Object.keys(stateNames).forEach(function(code) { %>
                      <option value="<%= code %>" <%= selectedState === code ? 'selected' : '' %>><%= stateNames[code] %></option>
                    <% }) %>
                  </select>
                <% } else if (f.type === 'county_select') { %>
                  <% const selectedCounty = formValues[f.key] || ''; %>
                  <select id="<%= f.key %>" name="<%= f.key %>" class="county-select"
                          data-depends-on="<%= f.dependsOn %>" data-selected="<%= selectedCounty %>" <%= f.required ? 'required' : '' %>>
                    <option value="">Select a state first&hellip;</option>
                  </select>
                <% } else { %>
                  <input type="text" id="<%= f.key %>" name="<%= f.key %>" value="<%= formValues[f.key] || '' %>" <%= f.required ? 'required' : '' %> />
                <% } %>
              </div>
            <% }) %>
          </div>
        <% }) %>

        <div style="margin-top: 20px; display:flex; gap:12px;">
          <button type="submit" class="btn">Preview &amp; Send</button>
          <a href="/dashboard" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>

  <script>
    var COUNTIES_BY_STATE = <%- JSON.stringify(countiesByState) %>;
    var TITLE_COMPANIES = <%- JSON.stringify(titleCompanies) %>;

    // Fills in the Escrow / Title Company fields from the chosen saved
    // company - the fields stay plain inputs the team can still edit or
    // clear, so picking one is just a shortcut, not a lock.
    function applySavedTitleCompany(select) {
      var form = select.closest('form');
      var idx = select.value;
      if (idx === '') return;
      var c = TITLE_COMPANIES[Number(idx)];
      if (!c) return;
      var setIfPresent = function (id, value) {
        var input = form.querySelector('#' + id);
        if (input) input.value = value || '';
      };
      setIfPresent('escrow_company', c.name);
      setIfPresent('escrow_contact_name', c.contactName);
      setIfPresent('escrow_phone', c.phone);
      setIfPresent('escrow_email', c.email);
      setIfPresent('escrow_address', c.address);
    }

    function populateCountySelect(countySelect, stateCode, selectedValue) {
      var counties = (stateCode && COUNTIES_BY_STATE[stateCode]) || [];
      countySelect.innerHTML = '';
      var placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = counties.length ? 'Select a county…' : 'Select a state first…';
      countySelect.appendChild(placeholder);
      counties.forEach(function (countyName) {
        var opt = document.createElement('option');
        opt.value = countyName;
        opt.textContent = countyName;
        if (selectedValue && selectedValue === countyName) opt.selected = true;
        countySelect.appendChild(opt);
      });
    }

    function onStateChange(stateSelect) {
      var countySelect = stateSelect.closest('form').querySelector(
        '.county-select[data-depends-on="' + stateSelect.id + '"]'
      );
      if (countySelect) populateCountySelect(countySelect, stateSelect.value, null);
    }

    // On page load, populate every county dropdown from its paired state
    // dropdown's current value (handles both a fresh form with a default
    // state, like Novation's "OH", and a re-render after a validation error
    // where the user had already picked a state and county).
    document.querySelectorAll('.county-select').forEach(function (countySelect) {
      var stateSelect = document.getElementById(countySelect.dataset.dependsOn);
      var selected = countySelect.dataset.selected || '';
      if (stateSelect) {
        populateCountySelect(countySelect, stateSelect.value, selected);
      }
    });

    function addSignerRow(btn, roleKey) {
      const group = btn.closest('.multi-signer-group');
      const entry = document.createElement('div');
      entry.className = 'multi-signer-entry';
      entry.innerHTML =
        '<div class="field" style="margin-bottom:0;">' +
          '<label>Name</label>' +
          '<input type="text" name="signer_' + roleKey + '_name[]" />' +
        '</div>' +
        '<div class="field" style="margin-bottom:0;">' +
          '<label>Email</label>' +
          '<input type="email" name="signer_' + roleKey + '_email[]" />' +
        '</div>' +
        '<button type="button" class="btn-tiny remove-signer-row" onclick="removeSignerRow(this)">Remove</button>';
      group.insertBefore(entry, btn);
      updateRemoveVisibility(group);
    }

    function removeSignerRow(btn) {
      const entry = btn.closest('.multi-signer-entry');
      const group = entry.closest('.multi-signer-group');
      if (group.querySelectorAll('.multi-signer-entry').length > 1) {
        entry.remove();
        updateRemoveVisibility(group);
      } else {
        // Never remove the last row - just clear it.
        entry.querySelectorAll('input').forEach(function (i) { i.value = ''; });
      }
    }

    function updateRemoveVisibility(group) {
      const rows = group.querySelectorAll('.multi-signer-entry');
      rows.forEach(function (row) {
        const removeBtn = row.querySelector('.remove-signer-row');
        removeBtn.style.visibility = rows.length > 1 ? 'visible' : 'hidden';
      });
    }
  </script>
</body>
</html>
