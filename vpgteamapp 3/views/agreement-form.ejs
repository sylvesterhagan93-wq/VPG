<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>VPGteamapp - <%= typeDef.label %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/topbar') %>

  <div class="container">
    <div class="page-title"><%= typeDef.label %></div>
    <div class="page-subtitle"><%= typeDef.description %></div>

    <% if (error) { %>
      <div class="alert error"><%= error %></div>
    <% } %>

    <div class="card">
      <form method="POST" action="/agreements/new/<%= typeDef.key %>">

        <div class="section-label">Signers</div>
        <% typeDef.signers.forEach(function(s) { %>
          <div class="signer-row">
            <div class="signer-label">
              <%= s.label %>
              <% if (s.internal) { %>
                <span style="font-weight:400; color:#6b7280;">&mdash; defaults to you, editable if someone else on the team is signing</span>
              <% } %>
            </div>
            <div class="field" style="margin-bottom:0;">
              <label for="signer_<%= s.key %>_name">Name</label>
              <input type="text" id="signer_<%= s.key %>_name" name="signer_<%= s.key %>_name"
                     value="<%= formValues['signer_' + s.key + '_name'] || '' %>" required />
            </div>
            <div class="field" style="margin-bottom:0;">
              <label for="signer_<%= s.key %>_email">Email</label>
              <input type="email" id="signer_<%= s.key %>_email" name="signer_<%= s.key %>_email"
                     value="<%= formValues['signer_' + s.key + '_email'] || '' %>" required />
            </div>
          </div>
        <% }) %>

        <%
          // Group fields by their optional `section`, preserving field order.
          // Fields with no section fall under the default "Agreement Details" group.
          const groups = [];
          typeDef.fields.forEach(function(f) {
            const label = f.section || "Agreement Details";
            let group = groups.find(function(g) { return g.label === label; });
            if (!group) { group = { label: label, fields: [] }; groups.push(group); }
            group.fields.push(f);
          });
        %>
        <% groups.forEach(function(group) { %>
          <div class="section-label"><%= group.label %></div>
          <div class="form-grid">
            <% group.fields.forEach(function(f) { %>
              <div class="field <%= f.type === 'textarea' ? 'full' : '' %>">
                <label for="<%= f.key %>"><%= f.label %><% if (f.required) { %> *<% } %></label>
                <% if (f.type === 'textarea') { %>
                  <textarea id="<%= f.key %>" name="<%= f.key %>" <%= f.required ? 'required' : '' %>><%= formValues[f.key] || '' %></textarea>
                <% } else if (f.type === 'date') { %>
                  <input type="date" id="<%= f.key %>" name="<%= f.key %>" value="<%= formValues[f.key] || '' %>" <%= f.required ? 'required' : '' %> />
                <% } else { %>
                  <input type="text" id="<%= f.key %>" name="<%= f.key %>" value="<%= formValues[f.key] || '' %>" <%= f.required ? 'required' : '' %> />
                <% } %>
              </div>
            <% }) %>
          </div>
        <% }) %>

        <div style="margin-top: 20px; display:flex; gap:12px;">
          <button type="submit" class="btn">Send for Signature</button>
          <a href="/dashboard" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
