<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>VPGteamapp - Preview Offer Letter</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/topbar') %>

  <div class="container preview-container">
    <div class="page-title">Preview: Offer Letter</div>
    <div class="page-subtitle">
      This is exactly the proposal PDF that will be emailed to
      <strong><%= fields.seller_name %></strong> (<%= fields.seller_email %>) for
      <strong><%= fields.property_address %></strong>. Nothing has been sent yet -
      review it below, then Approve &amp; Send or go back and make changes.
    </div>

    <% if (!emailConfigured) { %>
      <div class="alert info">
        <strong>Mock mode:</strong> Gmail isn't connected yet, so approving this will log the send but won't
        actually email anyone. The proposal PDF below is still the real document.
      </div>
    <% } else { %>
      <div class="alert info">
        Nothing has gone out yet. This letter only emails once you click <strong>Approve &amp; Send</strong> below.
      </div>
    <% } %>

    <div class="card" style="margin-bottom:20px;">
      <p style="margin:0 0 6px;"><strong>Subject:</strong> <%= fields.email_subject %></p>
      <p style="margin:0; white-space:pre-wrap; color:var(--muted); font-size:13px;"><%= fields.email_body %></p>
    </div>

    <div class="card pdf-preview-card">
      <embed
        src="data:application/pdf;base64,<%= pdfBase64 %>"
        type="application/pdf"
        class="pdf-preview-frame"
      />
      <p class="pdf-preview-fallback">
        Can't see the document above? Your browser may not support inline PDF preview -
        <a href="data:application/pdf;base64,<%= pdfBase64 %>" target="_blank" rel="noopener">open it in a new tab</a> instead.
      </p>
    </div>

    <div class="preview-actions">
      <form method="POST" action="/offer-letters/send/edit">
        <input type="hidden" name="formDataJson" value="<%= formDataJson %>" />
        <button type="submit" class="btn btn-secondary">&larr; Back to Edit</button>
      </form>
      <form method="POST" action="/offer-letters/send/confirm">
        <input type="hidden" name="formDataJson" value="<%= formDataJson %>" />
        <button type="submit" class="btn">Approve &amp; Send</button>
      </form>
    </div>
  </div>
</body>
</html>
