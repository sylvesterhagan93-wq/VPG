# Postgres connection string (Supabase: Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Session secret - set to a long random string in production
SESSION_SECRET=change_this_to_a_random_secret_string

# HelloSign / Dropbox Sign API key (from https://app.hellosign.com/home/myAccount#api)
HELLOSIGN_API_KEY=

# If left blank above, the app runs in MOCK SEND mode: agreements are logged
# and marked "Sent (mock)" instead of actually calling HelloSign. This lets
# your team test the whole flow before the real API key is added.

PORT=3000
